# Optional Nimiq mainnet RPC override.
VITE_NIMIQ_RPC_URL=https://rpc.nimiqwatch.com

# Optional Nimiq Hub override. The official Hub serves mainnet payments.
VITE_NIMIQ_HUB_URL=https://hub.nimiq.com

# Required for real cross-device Arka invites.
# Apply every SQL file in supabase/migrations in filename order first.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use VITE_SUPABASE_ANON_KEY instead.

# Optional private product analytics. Apply the analytics migration first.
# Analytics data is never displayed inside the Mini App.
VITE_ANALYTICS_ENABLED=false
# Set this to the deployed release or commit identifier.
VITE_APP_VERSION=

# Cashback claims are checked by Vercel BotID and verified against Nimiq
# mainnet. The public address is safe to expose; never add a private key or
# seed phrase. SUPABASE_SERVICE_ROLE_KEY remains server-only.
VITE_CASHBACK_TREASURY_ADDRESS=
CASHBACK_TREASURY_ADDRESS=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NIMIQ_RPC_URL=https://rpc.nimiqwatch.com

# Never add a Supabase secret/service_role key to a VITE_* variable.
